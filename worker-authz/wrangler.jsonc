{
  "name": "etzhayyim-authz",
  "main": "src-ts/index.ts",
  "compatibility_date": "2025-03-17",
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "accounts@etzhayyim.com",
    "GOOGLE_OAUTH_CLIENT_ID": "",
    "GOOGLE_OAUTH_CLIENT_SECRET": "",
    "MICROSOFT_OAUTH_CLIENT_ID": "",
    "MICROSOFT_OAUTH_CLIENT_SECRET": "",
    "ETH_PRIVATE_CHAIN_ID": "260425",
    "ETH_PRIVATE_RPC_URL": "https://geth.etzhayyim.com",
    "etzhayyim_ACTOR_REGISTRY_ADDR": "0xc097cC8f6dfa6f3a539b0De36E9Bb550B9AA7025",
    "etzhayyim_CSW_FACTORY_ADDR": "0x0B71Ffb6D6cD7e9Ca7Fa6574084B55273efb9eE5",
    "etzhayyim_CREDIT_ADDR": "0x8e9A5162b2800E0D19acC1708A531A3954900E21",
    "etzhayyim_DEPLOY_REGISTRY_ADDR": "0x995AD6A2bb4D8916Ba036f5B2e29E7739Ee243b5",
    "etzhayyim_ROOT_IDENTITY_REGISTRY_ADDR": "0x11405300Fb75C5CDd665B9c0Ef445F8E312e3ee8",
    "etzhayyim_MURAKUMO_REGISTRY_ADDR": "0x4E3d742ece9483f97c3094b40c4b8C7901a6E3B6",
    "etzhayyim_MURAKUMO_ESCROW_ADDR": "0xD0DAB2B574948d4c8Bb9cF1D751CD0C6662f484d",
    "etzhayyim_CLAIM_STAKE_ESCROW_ADDR": "0x8448Bd7FC883d0735D8A2416DAd0B7e4FbFA9767",
    "etzhayyim_REGO_ARBITER_ADDR": "0x53E29CA12Bd77fD35926627318036c7B2BBE245d",
    "etzhayyim_MURAKUMO_BRIDGE_ADDR": "0xE10149ECCdF963092a0C9DC99D72C8ADb860C04c",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "etzhayyim-auth-passkey",
      "database_id": "d70191cf-9799-48c8-8208-289bcb14593f"
    },
    {
      "binding": "KEYS_DB",
      "database_name": "etzhayyim-keys",
      "database_id": "3b3c7e8a-ad90-4065-a18c-18cfc8e77223"
    }
  ],
  "services": [
    {
      "binding": "AUTHN_SERVICE",
      "service": "etzhayyim-auth"
    }
  ],
  "routes": [
    {
      "pattern": "accounts.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "authz.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ]
}
