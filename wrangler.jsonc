{
  "name": "itonami-app-auth",
  // The shadow-cljs :esm output directly — no generated shim needed.
  "main": "js/auth-worker.js",
  "compatibility_date": "2026-08-12",
  // Deliberately no "nodejs_compat": everything this Worker does — SHA-256
  // digests, random tokens, P-256 signature verification — is WebCrypto
  // (webauthn.adapters.edge). Nothing reaches for node:crypto or Buffer, and
  // keeping the flag off makes that a build-time guarantee rather than a
  // convention.
  "routes": [
    {
      "pattern": "auth.itonami.cloud",
      "custom_domain": true
    },
    {
      // Compatibility route. GET /auth moves to the host-level surface; the
      // old API paths remain during the session migration window.
      "pattern": "app.itonami.cloud/auth*",
      "zone_name": "itonami.cloud"
    }
  ],
  // Sessions, single-use sign-in challenges, and the clone-detection
  // baseline. A Durable Object and not KV because all three need
  // read-your-writes: a challenge that can be consumed twice is a replayable
  // sign-in, and a baseline read from an eventually-consistent store produced
  // a measured clone-check false negative on 2026-08-03 (ADR-2607302145).
  // Pages Functions cannot bind one at all, which is why this surface is a
  // Worker.
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_STORE",
        "class_name": "AuthStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-auth-store",
      "new_sqlite_classes": ["AuthStore"]
    }
  ],
  // The SAME namespace network-awai/cloud-itonami writes credentials to, by
  // id — not a new one. That is what makes an existing itonami passkey work
  // here on day one: this service has no separate idea of who has enrolled,
  // so there is no set of users for the two surfaces to disagree about.
  //
  // Read-mostly. The one write is the shared signCount/backup record, kept in
  // step so the other surface's clone check does not go stale while this one
  // is in use (itonami.auth.store/touch-credential!).
  "kv_namespaces": [
    {
      "binding": "ITONAMI_DATA",
      "id": "e9857fe8617440e59f9720293dc53afd"
    }
  ],
  // Federated providers and Email are fail-closed Worker secrets; see README.
  // No placeholder belongs in vars: a button is exposed only when its exact
  // required bindings exist. Install with `wrangler secret put <NAME>`.
  // No KEK binding, and that is the security boundary of this repo: the
  // credential records carry a sealed Ed25519 key wrapped under
  // cloud-itonami's KEK, and without it this Worker cannot unwrap or sign as
  // anybody. Enrolment — which mints that key — stays at itonami.cloud/signin/.
  "observability": {
    "enabled": true
  }
}
